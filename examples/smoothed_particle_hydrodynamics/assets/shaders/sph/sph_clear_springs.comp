#version 450

#include "sph/sph_spring_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0)
buffer SpringAHeads
{
    uint springAHeads[];
};

layout(std430, binding = 1)
writeonly buffer SpringBHeads
{
    uint springBHeads[];
};

layout(std430, binding = 2)
writeonly buffer RecycledParticles
{
    uint recycledParticles[];
};

layout(push_constant)
uniform PushConstants
{
    uint particleCount;
    uint springCounterIndex;
    uint clearRecycledParticles;
    uint padding;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i < pc.particleCount)
    {
        springAHeads[i] = INVALID_SPRING_INDEX;

        springBHeads[i] = INVALID_SPRING_INDEX;

        if (pc.clearRecycledParticles != 0u)
        {
            recycledParticles[i] = 0u;
        }
    }

    if (i == 0u)
    {
        springAHeads[pc.springCounterIndex] = 0u;
    }
}
