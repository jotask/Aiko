float circle(vec2 p, vec2 center, float radius)
{
    return 1.0 - smoothstep(
        radius - 2.0,
        radius + 2.0,
        length(p - center)
    );
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 uv = fragCoord / iResolution.xy;

    float pulse = 0.5 + 0.5 * sin(iTime);

    vec3 color = vec3(uv.x, uv.y, pulse);

    if (iMouse.z != 0.0)
    {
        vec2 clickPosition = abs(iMouse.zw);

        float mouseCircle = circle(fragCoord, clickPosition, 18.0);

        color = mix(color, vec3(1.0), mouseCircle);
    }

    float framePulse = 0.5 + 0.5 * sin(float(iFrame) * 0.02);

    color.b *= 0.75 + framePulse * 0.25;

    fragColor = vec4(color, 1.0);
}