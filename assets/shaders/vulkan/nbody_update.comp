#version 450

#include "aiko_compute.glsl"

layout(std430, set = 0, binding = 0) readonly buffer NBodyPositionMassBuffer
{
    vec4 u_posMass[];
};

layout(std430, set = 0, binding = 1) readonly buffer NBodyVelocityBuffer
{
    vec4 u_vel[];
};

layout(std430, set = 0, binding = 2) writeonly buffer NBodyPositionMassNextBuffer
{
    vec4 u_posMassNext[];
};

layout(std430, set = 0, binding = 3) writeonly buffer NBodyVelocityNextBuffer
{
    vec4 u_velNext[];
};

layout(push_constant) uniform NBodyUpdatePushConstants
{
    vec4 u_params;
    vec4 u_gravity;
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    uint count = uint(u_params.z);

    if (idx >= count)
    {
        return;
    }

    float dt = aiko_time.y;
    float timeScale = u_params.x;
    float softening = u_params.y;

    vec4 selfPosMass = u_posMass[idx];
    vec3 pos = selfPosMass.xyz;
    float selfMass = selfPosMass.w;

    vec3 vel = u_vel[idx].xyz;

    vec3 accel = vec3(0.0);

    for (uint j = 0; j < count; ++j)
    {
        if (j == idx)
        {
            continue;
        }

        vec4 otherPosMass = u_posMass[j];
        vec3 delta = otherPosMass.xyz - pos;

        float dist2 = dot(delta, delta) + softening * softening;
        float invDist = inversesqrt(dist2);
        float invDist3 = invDist * invDist * invDist;

        accel += delta * u_gravity.xyz * otherPosMass.w * invDist3;
    }

    float centralMass = u_gravity.w;

    if (centralMass > 0.0)
    {
        vec3 deltaCenter = -pos;
        float dist2Center = dot(deltaCenter, deltaCenter) + softening * softening;
        float invDistCenter = inversesqrt(dist2Center);
        float invDistCenter3 = invDistCenter * invDistCenter * invDistCenter;

        accel += deltaCenter * u_gravity.xyz * centralMass * invDistCenter3;
    }

    float step = dt * timeScale;

    vel += accel * step;
    pos += vel * step;

    u_posMassNext[idx] = vec4(pos, selfMass);
    u_velNext[idx] = vec4(vel, 0.0);
}
