#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0)
buffer CellKeys
{
    uint cellKeys[];
};

layout(std430, binding = 1)
buffer ParticleIndices
{
    uint particleIndices[];
};

layout(push_constant)
uniform PushConstants
{
    uint particleCount;
    uint k;
    uint j;
    uint padding;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.particleCount)
    {
        return;
    }

    uint ixj = i ^ pc.j;

    if (ixj <= i || ixj >= pc.particleCount)
    {
        return;
    }

    bool ascending = (i & pc.k) == 0;

    uint keyA = cellKeys[i];
    uint keyB = cellKeys[ixj];

    bool shouldSwap = ascending ? keyA > keyB : keyA < keyB;

    if (shouldSwap)
    {
        uint indexA = particleIndices[i];

        cellKeys[i] = keyB;
        cellKeys[ixj] = keyA;

        particleIndices[i] = particleIndices[ixj];
        particleIndices[ixj] = indexA;
    }
}