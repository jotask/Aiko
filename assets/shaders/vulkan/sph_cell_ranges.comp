#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0)
readonly buffer CellKeys
{
    uint cellKeys[];
};

layout(std430, binding = 1)
buffer CellStarts
{
    uint cellStarts[];
};

layout(std430, binding = 2)
buffer CellEnds
{
    uint cellEnds[];
};

layout(push_constant)
uniform PushConstants
{
    uint particleCount;
    uint cellCount;
    uint padding0;
    uint padding1;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.particleCount)
    {
        return;
    }

    uint key = cellKeys[i];

    if (key >= pc.cellCount)
    {
        return;
    }

    if (i == 0)
    {
        cellStarts[key] = 0;
    }
    else
    {
        uint previousKey = cellKeys[i - 1];

        if (previousKey != key)
        {
            cellStarts[key] = i;
            cellEnds[previousKey] = i;
        }
    }

    if (i == pc.particleCount - 1)
    {
        cellEnds[key] = pc.particleCount;
    }
}