#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0)
readonly buffer Positions
{
    vec4 positions[];
};

layout(std430, binding = 1)
readonly buffer CellHeads
{
    uint cellHeads[];
};

layout(std430, binding = 2)
readonly buffer ParticleNext
{
    uint particleNext[];
};

layout(std430, binding = 3)
readonly buffer Pressures
{
    vec4 pressures[];
};

layout(std430, binding = 4)
writeonly buffer PositionDeltas
{
    vec4 positionDeltas[];
};

layout(push_constant)
uniform PushConstants
{
    float dt;
    float smoothingRadius;
    uint particleCount;
    uint gridWidth;

    uint gridHeight;
    uint padding0;
    uint padding1;
    uint padding2;

    vec4 boundsMin;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.particleCount)
    {
        return;
    }

    vec3 positionA = positions[i].xyz;

    vec2 pressureA = pressures[i].xy;

    ivec2 cell = ivec2(floor((positionA.xy - pc.boundsMin.xy) / pc.smoothingRadius));

    vec3 delta = vec3(0.0);

    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 neighbourCell = cell + ivec2(x, y);

            if (neighbourCell.x < 0 || neighbourCell.y < 0 || neighbourCell.x >= int(pc.gridWidth) || neighbourCell.y >= int(pc.gridHeight))
            {
                continue;
            }

            uint key = uint(neighbourCell.y) * pc.gridWidth + uint(neighbourCell.x);

            uint j = cellHeads[key];

            while (j != 0xFFFFFFFFu)
            {
                uint nextParticle = particleNext[j];

                if (j != i)
                {
                    vec3 direction = positions[j].xyz - positionA;

                    float distance = length(direction);

                    if (distance > 0.000001 && distance < pc.smoothingRadius)
                    {
                        float q = distance / pc.smoothingRadius;

                        float oneMinusQ = 1.0 - q;

                        vec3 normalizedDirection = direction / distance;

                        vec2 pressureB = pressures[j].xy;

                        float displacementTermA = pc.dt * pc.dt * (pressureA.x * oneMinusQ + pressureA.y * oneMinusQ * oneMinusQ);

                        float displacementTermB = pc.dt * pc.dt * (pressureB.x * oneMinusQ + pressureB.y * oneMinusQ * oneMinusQ);

                        delta -= normalizedDirection * (displacementTermA + displacementTermB) * 0.5;
                    }
                }

                j = nextParticle;
            }
        }
    }

    positionDeltas[i] = vec4(delta, 0.0);
}