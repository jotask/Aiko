#version 450

#include "sph/sph_spring_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0)
readonly buffer Positions
{
    vec4 positions[];
};

layout(std430, binding = 1)
readonly buffer PreviousSprings
{
    Spring previousSprings[];
};

layout(std430, binding = 2)
buffer CurrentSprings
{
    Spring currentSprings[];
};

layout(push_constant)
uniform PushConstants
{
    float dt;
    float gamma;
    float plasticity;
    float smoothingRadius;

    uint maxSprings;
    uint padding0;
    uint padding1;
    uint padding2;
} pc;

void insertSpring(Spring spring)
{
    uint mask = pc.maxSprings - 1u;

    uint slot = hashPairKey(spring.pairKey) & mask;

    for (uint probe = 0; probe < MAX_SPRING_PROBES;  ++probe)
    {
        uint previousKey = atomicCompSwap(currentSprings[slot].pairKey, EMPTY_SPRING_KEY, spring.pairKey);

        if (
        previousKey == EMPTY_SPRING_KEY ||
        previousKey == spring.pairKey)
        {
            currentSprings[slot].restLength =
            spring.restLength;

            currentSprings[slot].enabled =
            spring.enabled;

            currentSprings[slot].padding =
            0u;

            return;
        }

        slot =
        (slot + 1u) &
        mask;
    }
}

void main()
{
    uint springIndex = gl_GlobalInvocationID.x;

    if (springIndex >= pc.maxSprings)
    {
        return;
    }

    Spring spring = previousSprings[springIndex];

    if (spring.pairKey == EMPTY_SPRING_KEY || spring.enabled == 0u)
    {
        return;
    }

    uint particleA = getParticleA(spring.pairKey);
    uint particleB = getParticleB(spring.pairKey);

    vec3 positionA = positions[particleA].xyz;
    vec3 positionB = positions[particleB].xyz;

    float distance = length(positionA - positionB);

    float deformation = pc.gamma * spring.restLength;

    if (distance > spring.restLength + deformation)
    {
        spring.restLength += pc.dt * pc.plasticity * (distance - spring.restLength - deformation);
    }
    else if (distance < spring.restLength - deformation)
    {
        spring.restLength -= pc.dt * pc.plasticity * (spring.restLength - deformation - distance);
    }

    if (spring.restLength > pc.smoothingRadius)
    {
        return;
    }

    insertSpring(spring);
}