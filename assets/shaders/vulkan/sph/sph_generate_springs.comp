#version 450

#include "sph/sph_spring_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0)
readonly buffer Positions
{
    vec4 positions[];
};

layout(std430, binding = 1)
readonly buffer CellHeads
{
    uint cellHeads[];
};

layout(std430, binding = 2)
readonly buffer ParticleNext
{
    uint particleNext[];
};

layout(std430, binding = 3)
buffer Springs
{
    Spring springs[];
};

layout(std430, binding = 4)
buffer SpringHeads
{
    uint springHeads[];
};

layout(push_constant)
uniform PushConstants
{
    float smoothingRadius;
    float dt;
    float gamma;
    float plasticity;

    uint particleCount;
    uint gridWidth;
    uint gridHeight;
    uint maxSprings;

    vec4 boundsMin;
} pc;

void linkSpring(uint springIndex, uint pairKey)
{
    uint particleA = getParticleA(pairKey);
    uint particleB = getParticleB(pairKey);

    uint previousHeadA = atomicExchange(springHeads[particleA], springIndex);
    uint previousHeadB = atomicExchange(springHeads[particleB], springIndex);

    springs[springIndex].nextA = previousHeadA;
    springs[springIndex].nextB = previousHeadB;
}

void insertSpring(uint pairKey, float initialRestLength)
{
    uint mask = pc.maxSprings - 1u;

    uint slot = hashPairKey(pairKey) & mask;

    for (uint probe = 0; probe < MAX_SPRING_PROBES; ++probe)
    {
        uint currentKey = springs[slot].pairKey;

        if (currentKey == pairKey)
        {
            return;
        }

        if (currentKey == EMPTY_SPRING_KEY)
        {
            uint previousKey = atomicCompSwap(springs[slot].pairKey, EMPTY_SPRING_KEY, pairKey);

            if (previousKey == EMPTY_SPRING_KEY)
            {
                springs[slot].restLength = initialRestLength;

                linkSpring(slot, pairKey);

                return;
            }

            if (previousKey == pairKey)
            {
                return;
            }
        }

        slot = (slot + 1u) & mask;
    }
}

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.particleCount)
    {
        return;
    }

    vec3 positionA = positions[i].xyz;

    ivec2 cell = ivec2(floor((positionA.xy - pc.boundsMin.xy) /pc.smoothingRadius));

    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 neighbourCell = cell + ivec2(x, y);

            if ( neighbourCell.x < 0 || neighbourCell.y < 0 || neighbourCell.x >= int(pc.gridWidth) || neighbourCell.y >= int(pc.gridHeight))
            {
                continue;
            }

            uint cellKey = uint(neighbourCell.y) * pc.gridWidth + uint(neighbourCell.x);

            uint j = cellHeads[cellKey];

            while (j != 0xFFFFFFFFu)
            {
                uint nextParticle = particleNext[j];

                if (j > i)
                {
                    vec3 direction = positions[j].xyz - positionA;

                    float distance = length(direction);

                    if (distance < pc.smoothingRadius)
                    {
                        uint pairKey = makePairKey(i, j);

                        float restLength = pc.smoothingRadius;

                        float deformation = pc.gamma * restLength;

                        if (distance < restLength - deformation)
                        {
                            restLength -= pc.dt * pc.plasticity * (restLength - deformation - distance);
                        }

                        insertSpring(pairKey, restLength);
                    }
                }

                j = nextParticle;
            }
        }
    }
}