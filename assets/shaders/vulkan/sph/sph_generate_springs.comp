#version 450

#include "sph/sph_spring_common.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0)
readonly buffer Positions
{
    vec4 positions[];
};

layout(std430, binding = 1)
readonly buffer CellHeads
{
    uint cellHeads[];
};

layout(std430, binding = 2)
readonly buffer ParticleNext
{
    uint particleNext[];
};

layout(std430, binding = 3)
readonly buffer PreviousSprings
{
    Spring previousSprings[];
};

layout(std430, binding = 4)
readonly buffer PreviousSpringAHeads
{
    uint previousSpringAHeads[];
};

layout(std430, binding = 5)
buffer CurrentSprings
{
    Spring currentSprings[];
};

layout(std430, binding = 6)
buffer CurrentSpringAHeads
{
    uint currentSpringAHeads[];
};

layout(std430, binding = 7)
buffer CurrentSpringBHeads
{
    uint currentSpringBHeads[];
};

layout(push_constant)
uniform PushConstants
{
    float smoothingRadius;
    float dt;
    float gamma;
    float plasticity;

    uint particleCount;
    uint gridWidth;
    uint gridHeight;
    uint maxSprings;

    uint springCounterIndex;

    vec4 boundsMin;
} pc;

bool findPreviousSpring(uint particle, uint pairKey, out float restLength)
{
    uint springIndex = previousSpringAHeads[particle];

    while (springIndex != INVALID_SPRING_INDEX)
    {
        Spring spring = previousSprings[springIndex];

        if (spring.pairKey == pairKey)
        {
            restLength = spring.restLength;
            return true;
        }

        springIndex = spring.nextA;
    }

    return false;
}

void appendSpring(uint pairKey, float restLength, inout uint springAHead)
{
    uint springIndex = atomicAdd(currentSpringAHeads[pc.springCounterIndex], 1u);

    if (springIndex >= pc.maxSprings)
    {
        return;
    }

    uint particleB = getParticleB(pairKey);

    uint previousHeadA = springAHead;
    springAHead = springIndex;

    uint previousHeadB = atomicExchange(currentSpringBHeads[particleB], springIndex);

    currentSprings[springIndex].pairKey = pairKey;
    currentSprings[springIndex].restLength = restLength;
    currentSprings[springIndex].nextA = previousHeadA;
    currentSprings[springIndex].nextB = previousHeadB;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.particleCount)
    {
        return;
    }

    vec3 positionA = positions[i].xyz;
    uint springAHead = INVALID_SPRING_INDEX;

    ivec2 cell = ivec2(floor((positionA.xy - pc.boundsMin.xy) / pc.smoothingRadius));

    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 neighbourCell = cell + ivec2(x, y);

            if (neighbourCell.x < 0 || neighbourCell.y < 0 || neighbourCell.x >= int(pc.gridWidth) || neighbourCell.y >= int(pc.gridHeight))
            {
                continue;
            }

            uint cellKey = uint(neighbourCell.y) * pc.gridWidth + uint(neighbourCell.x);

            uint j = cellHeads[cellKey];

            while (j != INVALID_SPRING_INDEX)
            {
                uint nextParticle = particleNext[j];

                if (j > i)
                {
                    vec3 direction = positions[j].xyz - positionA;

                    float distance = length(direction);

                    if (distance < pc.smoothingRadius)
                    {
                        uint pairKey = makePairKey(i, j);

                        float restLength = 0.0;

                        bool existed = findPreviousSpring(i, pairKey, restLength);

                        if (existed)
                        {
                            float deformation = pc.gamma * restLength;

                            if (distance > restLength + deformation)
                            {
                                restLength += pc.dt * pc.plasticity * (distance - restLength - deformation);
                            }
                            else if (distance < restLength - deformation)
                            {
                                restLength -= pc.dt * pc.plasticity * (restLength - deformation - distance);
                            }

                            if (restLength <= pc.smoothingRadius)
                            {
                                appendSpring(pairKey, restLength, springAHead);
                            }
                        }
                        else
                        {
                            restLength = pc.smoothingRadius;

                            float deformation = pc.gamma * restLength;

                            if (distance < restLength - deformation)
                            {
                                restLength -= pc.dt * pc.plasticity * (restLength - deformation - distance);
                            }

                            appendSpring(pairKey, restLength, springAHead);
                        }
                    }
                }

                j = nextParticle;
            }
        }
    }

    currentSpringAHeads[i] = springAHead;
}
