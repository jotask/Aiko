#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0)
writeonly buffer CellHeads
{
    uint cellHeads[];
};

layout(push_constant)
uniform PushConstants
{
    uint cellCount;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.cellCount)
    {
        return;
    }

    cellHeads[i] = 0xFFFFFFFFu;
}