#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0)
readonly buffer Positions
{
    vec4 positions[];
};

layout(std430, binding = 1)
writeonly buffer CellKeys
{
    uint cellKeys[];
};

layout(std430, binding = 2)
writeonly buffer ParticleIndices
{
    uint particleIndices[];
};

layout(push_constant)
uniform PushConstants
{
    float smoothingRadius;
    uint particleCount;
    uint gridWidth;
    uint gridHeight;

    vec4 boundsMin;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.particleCount)
    {
        return;
    }

    vec2 position = positions[i].xy;
    vec2 localPosition = position - pc.boundsMin.xy;

    ivec2 cell = ivec2(floor(localPosition / pc.smoothingRadius));

    cell.x = clamp(cell.x, 0, int(pc.gridWidth) - 1);
    cell.y = clamp(cell.y, 0, int(pc.gridHeight) - 1);

    uint cellKey = uint(cell.y) * pc.gridWidth + uint(cell.x);

    cellKeys[i] = cellKey;

    particleIndices[i] = i;
}