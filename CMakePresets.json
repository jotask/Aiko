{
  "version": 6,
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "Core only / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AIKO_BUILD_EXAMPLES": "OFF",
        "AIKO_ENABLE_UNITY": "OFF"
      }
    },
    {
      "name": "all-debug",
      "displayName": "Core + examples / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/all-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AIKO_BUILD_EXAMPLES": "ON",
        "AIKO_ENABLE_UNITY": "OFF",
        "AIKO_PROFILER": "OFF"
      }
    },
    {
      "name": "all-debug-profiler",
      "displayName": "Core + examples / Debug / Profiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/all-debug-profiler",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AIKO_BUILD_EXAMPLES": "ON",
        "AIKO_ENABLE_UNITY": "OFF",
        "AIKO_PROFILER": "ON"
      }
    },
    {
      "name": "all-debug-unity",
      "displayName": "Core + examples / Debug / Unity",
      "inherits": "all-debug",
      "binaryDir": "${sourceDir}/build/all-debug-unity",
      "cacheVariables": {
        "AIKO_ENABLE_UNITY": "ON"
      }
    }
  ]
}
