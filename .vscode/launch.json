{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🧱 Build Only",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/examples/sandbox/CMakeFiles/Sandbox.dir/src",
            "args": [],
            "preLaunchTask": "Aiko: Build",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "description": "Set Disassembly Flavor to Intel", "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true }
            ]
        },
        {
            "name": "🚀 Run (No Build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/examples/sandbox",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "externalConsole": false
        },
        {
            "name": "🧩 Full (Configure + Build + Run)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/examples/sandbox/CMkeFiles/Sandbox.dir/srca",
            "args": [],
            "preLaunchTask": "Aiko: Full Build",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "description": "Set Disassembly Flavor to Intel", "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true }
            ]
        },
        {
            "name": "⚙️ Configure Only",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Aiko",
            "args": [],
            "preLaunchTask": "Aiko: Configure",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "externalConsole": false
        },

         {
            "name": "🧱 Build All (no run)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/examples/sandbox/Sandbox",
            "args": [],
            "preLaunchTask": "Aiko: Build",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "🚀 Run Sandbox",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/examples/sandbox/Sandbox",
            "args": [],
            "preLaunchTask": "Aiko: Build Sandbox",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/sandbox",
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Compile Shaders",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/tools/compile_shaders.py",
            "args": ["${workspaceFolder}/tools/compile_shaders.py"],
            "console": "integratedTerminal"
        }
    ]
}
